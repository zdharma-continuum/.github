#!/bin/sh
# Checks the commit messages of a push with the commitlint rules in
# commitlint.config.js, the same rules the CI job applies to pull requests.
#
# pre-push-hook downloads this script and runs it as git's pre-push hook:
# $1 is the name of the remote, and each line on standard input is
# "<local ref> <local sha> <remote ref> <remote sha>".
#
# COMMITLINT_BASE_URL overrides where the rules are downloaded from.

base_url=${COMMITLINT_BASE_URL:-https://raw.githubusercontent.com/zdharma-continuum/.github/main/commitlint}
remote=$1

skip() {
  echo "commitlint: $1; pushing without checking commit messages." >&2
  exit 0
}

command -v npx >/dev/null 2>&1 || skip "npx (Node.js) not found"

dir=$(mktemp -d) || skip "cannot create a temporary directory"
trap 'rm -rf "$dir"' EXIT
curl -fsSL "$base_url/commitlint.config.js" -o "$dir/commitlint.config.js" ||
  skip "cannot download the rules from $base_url"

is_zero() {
  case $1 in *[!0]*) return 1 ;; *) return 0 ;; esac
}

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  # Deleting a branch on the remote: no commits to check.
  is_zero "$local_sha" && continue

  if ! is_zero "$remote_sha" && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    # The remote already has this branch: check the commits added to it.
    from=$remote_sha
  else
    # A new branch, or the remote has commits this clone lacks: check the
    # commits that are on no branch of the remote yet.
    first=$(git rev-list --reverse "$local_sha" --not --remotes="$remote" | head -n 1)
    [ -n "$first" ] || continue
    from=$(git rev-parse -q --verify "$first^") || {
      echo "commitlint: $local_ref starts at a root commit; not checked." >&2
      continue
    }
  fi

  npx --yes -p @commitlint/cli -p @commitlint/config-conventional \
    commitlint --config "$dir/commitlint.config.js" \
    --from "$from" --to "$local_sha" || status=1
done

if [ "$status" -ne 0 ]; then
  echo "commitlint: push refused. Fix the messages above, e.g. with" >&2
  echo "'git commit --amend' or 'git rebase -i', and push again." >&2
fi
exit "$status"
